			(justify left bottom)
		)
		(uuid "af8b545b-2a52-49a7-9bb1-d49e9c8dbf0d")
	)
	(text "RXD uses both FLAG2 (B) and PB0 (C), as required by the C64 RS-232 software convention."
		(exclude_from_sim no)
		(at 35.56 146.05 0)
		(effects
			(font
