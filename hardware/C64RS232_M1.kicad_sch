		(uuid "80e57d30-e9ac-45ae-b000-6ccb1273a3a1")
	)
	(text "MAX3243 provides 3 drivers / 5 receivers, matching TXD/RTS/DTR and RXD/CTS/DSR/DCD/RI."
		(exclude_from_sim no)
		(at 35.56 149.86 0)
		(effects
			(font
